# Public (sent to the browser). Safe to expose: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public URL of the app, used in auth emails (e.g. https://marfa.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. NEVER prefix with NEXT_PUBLIC_. Used for inviting and
# deactivating users after the caller has been verified as an admin.
SUPABASE_SECRET_KEY=sb_secret_xxx
